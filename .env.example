# Google Drive folder ID where data will be stored
GOOGLE_DRIVE_FOLDER_ID=your_folder_id_here

# Path to Google service account credentials JSON file
GOOGLE_CREDENTIALS_PATH=./credentials.json

# Timezone (should be America/New_York for NJ Transit)
TZ=America/New_York

# Port for the health-check / manual-trigger HTTP server
PORT=3000

# Set to 'true' to run a scrape immediately on startup (useful for testing)
SCRAPE_ON_STARTUP=false
